  "things": [
    {"id":"charger","type":"charger","x":1.5,"y":10.5},
    {"id":"supply","type":"supply","x":1.5,"y":14.5},
    {"id":"luther","type":"luther","x":4.5,"y":11.5,"talk":[["LUTHER","Run me three places. Sixty-three ton."],["LUTHER","Undercut it first. Nobody shoots off the solid in my mine."],["LUTHER","Harold's paint is up at thirty. Not one cut past it."],["LUTHER","Belt tail moves up when you hit it with E and there's open entry ahead of it."],["LUTHER","Uncle Joe put Daddy's cow in the barn loft one time. Daddy went out to milk and she was up there in the hay."],["LUTHER","There's no way into that loft but a ladder. We took boards off the end of the barn and built a ramp to get her down. Uncle Joe helped."]]},
    {"id":"ebward","type":"ebward","x":8.5,"y":13.5,"talk":[["EB","Check your gas before every shot. Lamp's on 1."],["EB","If the flame grows a blue cap, hang a curtain on the face and give it time."],["EB","Dust roof, ribs and floor till no black shows."],["EB","Come up on my right side. I can't see you coming on the left."],["EB","Uncle Joe could show you things. Mommy wouldn't let him do it in the house."],["EB","Luther tells that cow story like he went up the ladder. I went up the ladder. She didn't have a mark on her."]]},
    {"id":"tail","type":"tail","x":13.5,"y":12.5}
  ],
  "triggers": [
    {"id":"begin","when":{"on":"start"}, "do": [
